#!/bin/sh

execdir="$PWD"

# valgrind tests memory usage.
# wine allow for windows testing on linux
if [ -n "${PARVALGRINDOPTS+set}" ]
then
    PARBINARY="valgrind $PARVALGRINDOPTS $execdir/par2"
elif [ "`which wine`" != "" ] && [ -f "$execdir/par2.exe" ]
then
    PARBINARY="wine $execdir/par2.exe"
else
    PARBINARY="$execdir/par2"
fi


if [ -z "$srcdir" ] || [ "." = "$srcdir" ]; then
  srcdir="$PWD"
  TESTDATA="$srcdir/tests"
else
  srcdir="$PWD/$srcdir"
  TESTDATA="$srcdir/tests"
fi

TESTROOT="$PWD"

testname=$(basename $0)
rm -f "$testname.log"
rm -rf "run$testname"

mkdir "run$testname" && cd "run$testname" || { echo "ERROR: Could not change to test directory" ; exit 1; } >&2

# The flatdata fixture is long runs of a single byte value, so a great many of
# its blocks are identical.  Corruption then desynchronises the sliding window
# scan and the blocks after it are found at offsets that are not their own, at
# which point repairing in place is no longer safe.  Use data that does not
# repeat, so the test is about in-place repair rather than about that.
for f in test-1.data test-2.data test-3.data
do
    dd if=/dev/urandom of=$f bs=1024 count=200 2>/dev/null \
        || { echo "ERROR: Could not create test data" ; exit 1; } >&2
done

banner="create recovery files"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

cp test-1.data test-1.data.orig
cp test-2.data test-2.data.orig

# 60 blocks over three equal files is 20 blocks each, so 24 recovery blocks is
# enough to rebuild a whole file from scratch, which one of the cases below
# needs.
$PARBINARY c -b60 -c24 testdata.par2 test-1.data test-2.data test-3.data \
    || { echo "ERROR: creating repair files using PAR 2.0 failed" ; exit 1; } >&2

# Record the inode so we can tell a genuine in-place repair from a rename and
# recreate that happened to clean up after itself.  Not every platform reports
# one, so this is only checked when it is available.
inode_before=`ls -i test-1.data 2>/dev/null | awk '{print $1}'`


banner="repair a damaged file in place"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

# Corrupt 4 bytes in the middle of the file without changing its length.
printf '\336\255\276\357' | dd of=test-1.data bs=1 seek=100000 count=4 conv=notrunc 2>/dev/null \
    || { echo "ERROR: Could not corrupt the test file" ; exit 1; } >&2

$PARBINARY r -i testdata.par2 > inplace.out 2>&1 \
    || { cat inplace.out ; echo "ERROR: in-place repair using PAR 2.0 failed" ; exit 1; } >&2
cat inplace.out

# Guard against a silent fallback making the rest of this pass for the wrong reason.
grep 'in place' inplace.out > /dev/null \
    || { echo "ERROR: the file was not repaired in place" ; exit 1; } >&2

if [ -e test-1.data.1 ]
then
    echo "ERROR: in-place repair created a backup copy" >&2
    exit 1
fi

cmp test-1.data test-1.data.orig \
    || { echo "ERROR: the in-place repaired file does not match the original" ; exit 1; } >&2

if [ -n "$inode_before" ]
then
    inode_after=`ls -i test-1.data | awk '{print $1}'`
    if [ "$inode_after" != "$inode_before" ]
    then
        echo "ERROR: the file was replaced rather than repaired in place" >&2
        exit 1
    fi
fi

$PARBINARY v testdata.par2 || { echo "ERROR: verify after in-place repair failed" ; exit 1; } >&2


banner="fall back to a new copy when the file is the wrong size"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

# The block positions in a file of the wrong length cannot be trusted, so this
# one has to be repaired the usual way.
size=`wc -c < test-1.data.orig | tr -d ' '`
dd if=test-1.data.orig of=test-1.data bs=1 count=`expr $size - 1` 2>/dev/null \
    || { echo "ERROR: Could not truncate the test file" ; exit 1; } >&2

$PARBINARY r -i testdata.par2 > fallback.out 2>&1 \
    || { cat fallback.out ; echo "ERROR: fallback repair using PAR 2.0 failed" ; exit 1; } >&2
cat fallback.out

grep 'Cannot repair' fallback.out > /dev/null \
    || { echo "ERROR: no reason was given for not repairing in place" ; exit 1; } >&2

if [ ! -e test-1.data.1 ]
then
    echo "ERROR: fallback repair did not create a backup copy" >&2
    exit 1
fi

cmp test-1.data test-1.data.orig \
    || { echo "ERROR: the repaired file does not match the original" ; exit 1; } >&2

rm -f test-1.data.1


banner="do not repair in place when the file holds another file's data"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

# test-1.data's path now holds test-2.data's content, and test-2.data is gone.
# Overwriting test-1.data in place would destroy the only copy of test-2.data.
cp test-2.data test-1.data
rm test-2.data

$PARBINARY r -i testdata.par2 > shared.out 2>&1 \
    || { cat shared.out ; echo "ERROR: repair using PAR 2.0 failed" ; exit 1; } >&2
cat shared.out

grep 'Cannot repair' shared.out > /dev/null \
    || { echo "ERROR: no reason was given for not repairing in place" ; exit 1; } >&2

cmp test-1.data test-1.data.orig \
    || { echo "ERROR: test-1.data does not match the original" ; exit 1; } >&2
cmp test-2.data test-2.data.orig \
    || { echo "ERROR: test-2.data was destroyed" ; exit 1; } >&2

rm -f test-1.data.1 test-2.data.1


banner="default behaviour still creates a backup copy"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

printf '\336\255\276\357' | dd of=test-1.data bs=1 seek=100000 count=4 conv=notrunc 2>/dev/null \
    || { echo "ERROR: Could not corrupt the test file" ; exit 1; } >&2

$PARBINARY r testdata.par2 || { echo "ERROR: repair using PAR 2.0 failed" ; exit 1; } >&2

if [ ! -e test-1.data.1 ]
then
    echo "ERROR: repair without -i stopped creating a backup copy" >&2
    exit 1
fi

cmp test-1.data test-1.data.orig \
    || { echo "ERROR: the repaired file does not match the original" ; exit 1; } >&2


banner="in-place repair and data skipping cannot be combined"
dashes=`echo "$banner" | sed s/./-/g`

echo $dashes
echo $banner
echo $dashes

$PARBINARY r -i -N testdata.par2 && { echo "ERROR: -i -N was accepted" ; exit 1; } >&2
$PARBINARY r -N -i testdata.par2 && { echo "ERROR: -N -i was accepted" ; exit 1; } >&2

cd "$TESTROOT"
rm -rf "run$testname"

exit 0
