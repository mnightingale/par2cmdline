  <PropertyGroup Label="UserMacros" />
  <!-- Same detection as parpar\gf16.vcxproj, and it has to stay in agreement
       with it: this test picks its backend from these defines, so a mismatch
       would silently reduce it to testing nothing. controller_vulkan.h keeps
       Vulkan behind a pimpl, so no SDK include path is needed here. -->
  <PropertyGroup>
    <ParParGlslang Condition="'$(ParParGlslang)'=='' And Exists('$(VULKAN_SDK)\Bin\glslangValidator.exe')">$(VULKAN_SDK)\Bin\glslangValidator.exe</ParParGlslang>
    <ParParGlslang Condition="'$(ParParGlslang)'=='' And Exists('$(VULKAN_SDK)\Bin\glslang.exe')">$(VULKAN_SDK)\Bin\glslang.exe</ParParGlslang>
    <ParParVulkan Condition="'$(ParParVulkan)'=='' And Exists('$(VULKAN_SDK)\Include\vulkan\vulkan.h') And '$(ParParGlslang)'!=''">true</ParParVulkan>
    <ParParVulkan Condition="'$(ParParVulkan)'==''">false</ParParVulkan>
    <ParParVulkanDefines Condition="'$(ParParVulkan)'=='true'">PARPAR_VULKAN_SUPPORT;</ParParVulkanDefines>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Must match parpar\gf16.vcxproj, which is where the backends this
           test drives are compiled; the autotools build passes the same set
           globally via AM_CPPFLAGS. -->
      <PreprocessorDefinitions>PARPAR_INVERT_SUPPORT;PARPAR_SLIM_GF16;PARPAR_GPU_SUPPORT;$(ParParVulkanDefines)%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <!-- parpar\gf16.vcxproj builds with WholeProgramOptimization, so every
           consumer has to link-time code-generate the whole of gf16.lib. This
           test pulls in far more of it than the other test executables (both
           GF16 backends, not just the CPU one), which took a rebuild here from
           seconds to six minutes. Incremental LTCG still pays that once, to
           populate its cache, but relinks after it drop back to ~5s, which is
           what matters when iterating on the backends. The test's own speed is
           irrelevant; the code it measures is already optimised in gf16.lib. -->
      <LinkTimeCodeGeneration>UseFastLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\src\gpu_test.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\libpar2.vcxproj">
      <Project>{d0a94f83-495e-4fb2-ac33-9a3ec2cc263b}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\parpar\gf16\controller.h" />
    <ClInclude Include="..\parpar\gf16\controller_cpu.h" />
    <ClInclude Include="..\parpar\gf16\gfmat_coeff.h" />
    <ClInclude Include="..\parpar\gf16\gpu_device.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
